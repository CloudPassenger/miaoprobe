# Example miaoprobe environment variables, e.g. for a Docker/Compose or
# systemd EnvironmentFile deployment.
#
# All variable names are the corresponding flag name, upper-cased, with the
# "." group separator turned into an underscore, prefixed with MP_ (e.g.
# --otel.endpoint -> MP_OTEL_ENDPOINT, --log.level -> MP_LOG_LEVEL).
# Precedence, highest to lowest: command-line flag > these env vars > YAML
# config file > flag default. See README.md#configuration.
#
# --filter is the one exception: it maps onto several MP_FILTER_* variables
# instead of a single MP_FILTER one (see below).

# --- global (list + check + serve) ---

MP_LOG_LEVEL=info
MP_LOG_FORMAT=rich

# --- shared by list, check, and serve ---

# required: a .js file, or a directory containing index.json
MP_SCRIPTS=/opt/miaospeed-scripts/dist

# script selection: id/category/region/tag are OR'd together, then mode
# decides whether matches are kept (include, the default) or dropped
# (exclude). Each is a comma-separated list, e.g. MP_FILTER_CATEGORY=media,ai.
# NOTE: unlike check/serve, `list` ignores these entirely unless --filter is
# also passed on its own command line -- it defaults to showing every
# script. See README.md#selecting-scripts---filter.
MP_FILTER_MODE=include
MP_FILTER_CATEGORY=
MP_FILTER_REGION=
MP_FILTER_TAG=
MP_FILTER_ID=

# --- list and check ---

# output format: table or json
MP_OUTPUT_FORMAT=table

# --- how a probe runs (check + serve) ---

# egress proxy: http://host:port, https://host:port, or socks5://host:port
# (empty = direct)
MP_PROBE_PROXY=socks5://127.0.0.1:1080

# per-script execution timeout
MP_PROBE_TIMEOUT=30s

# --- serve only ---

# polling interval
MP_PROBE_INTERVAL=5m

# how many scripts to probe in parallel
MP_PROBE_CONCURRENCY=8

# address /metrics is served on
MP_METRICS_LISTEN=:9765

# also export Go runtime and process metrics for diagnosing miaoprobe itself
MP_METRICS_RUNTIME=true

# OTLP endpoint to push metrics to (e.g. Grafana Cloud's OTLP gateway);
# empty disables push, falls back to OTEL_EXPORTER_OTLP_* env vars
MP_OTEL_ENDPOINT=

# unique service.instance.id used as Grafana's instance label; defaults to
# the host name
MP_OTEL_INSTANCE=

# OTLP wire protocol: http/protobuf or grpc
MP_OTEL_PROTOCOL=http/protobuf

# comma-separated key=value headers sent with every OTLP export
MP_OTEL_HEADERS=

# disable TLS for the OTLP connection (local collectors only)
MP_OTEL_INSECURE=false

# how often buffered metrics are pushed to MP_OTEL_ENDPOINT
MP_OTEL_INTERVAL=1m
