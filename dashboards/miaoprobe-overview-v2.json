{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Streaming unlock status per script, MediaUnlockTest-style at-a-glance panels (status distribution, unlock rate by segment) on top of miaoprobe's freshness and poll-cycle health. Status values: 1=unlocked, 0.5=warning, 0=failed, -1=unknown/error.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "At a glance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Count of scripts in each status over time, stacked. Failed results are split into region/service unavailability, transport-level network failures, and other probe failures. Older agents without failure_info appear under Other failure.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Scripts",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Unlocked" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Warning" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Unavailable" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Network" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Other failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Unknown" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8e8c8e", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 1) or vector(0)",
          "instant": false,
          "legendFormat": "Unlocked",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 0.5) or vector(0)",
          "instant": false,
          "legendFormat": "Warning",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(\n  (miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 0)\n    and on(job, instance, id)\n      miaoprobe_probe_failure_info{instance=~\"$instance\", id=~\"$script\", class=\"availability\"}\n) or vector(0)",
          "instant": false,
          "legendFormat": "Unavailable",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(\n  (miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 0)\n    and on(job, instance, id)\n      miaoprobe_probe_failure_info{instance=~\"$instance\", id=~\"$script\", class=\"network\"}\n) or vector(0)",
          "instant": false,
          "legendFormat": "Network",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "clamp_min(\n  (count(miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 0) or vector(0))\n  - (count(\n      (miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 0)\n        and on(job, instance, id)\n          miaoprobe_probe_failure_info{instance=~\"$instance\", id=~\"$script\", class=\"availability\"}\n    ) or vector(0))\n  - (count(\n      (miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == 0)\n        and on(job, instance, id)\n          miaoprobe_probe_failure_info{instance=~\"$instance\", id=~\"$script\", class=\"network\"}\n    ) or vector(0)),\n  0\n)",
          "instant": false,
          "legendFormat": "Other failure",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"} == -1) or vector(0)",
          "instant": false,
          "legendFormat": "Unknown",
          "range": true,
          "refId": "F"
        }
      ],
      "title": "Status distribution over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Timestamp of the least-recently-successful check across selected scripts (worst case). If this stops advancing, the status values on this dashboard are going stale and should not be trusted.",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "text", "mode": "fixed" },
          "mappings": [
            { "options": { "match": "null", "result": { "index": 0, "text": "no data" } }, "type": "special" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min(miaoprobe_last_success_timestamp_seconds{instance=~\"$instance\", id=~\"$script\"}) * 1000",
          "instant": true,
          "legendFormat": "last updated",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Last updated at",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 8,
      "panels": [],
      "title": "Current status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current unlock status per script, with configured metadata and the region detected by the latest successful probe. \"Last success\" is how long ago the script last produced a usable result — an empty value means it has never succeeded since this miaoprobe process started.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "custom.width", "value": 130 },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "-1": { "color": "#8e8c8e", "index": 3, "text": "Unknown" },
                      "0": { "color": "red", "index": 2, "text": "Failed" },
                      "0.5": { "color": "orange", "index": 1, "text": "Warning" },
                      "1": { "color": "green", "index": 0, "text": "Unlocked" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last success" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.width", "value": 130 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 900 },
                    { "color": "red", "value": 1800 }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "options": { "match": "null", "result": { "color": "red", "index": 0, "text": "never" } }, "type": "special" }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.width", "value": 110 },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          },
          {
            "matcher": { "id": "byName", "options": "Category" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "Detected region" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 10 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Status" }]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "(\n  (\n    miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"}\n      * on(job, instance, id) group_left(name, category, region, tags)\n        miaoprobe_script_info{instance=~\"$instance\", category=~\"$category\", id=~\"$script\"}\n  )\n    * on(job, instance, id) group_left(detected_region)\n      label_replace(\n        miaoprobe_probe_result_info{instance=~\"$instance\", id=~\"$script\"},\n        \"detected_region\", \"$1\", \"region\", \"(.*)\"\n      )\n)\nor on(job, instance, id)\n(\n  miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"}\n    * on(job, instance, id) group_left(name, category, region, tags)\n      miaoprobe_script_info{instance=~\"$instance\", category=~\"$category\", id=~\"$script\"}\n)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "time() - miaoprobe_last_success_timestamp_seconds{instance=~\"$instance\", id=~\"$script\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (job, instance, id) (miaoprobe_check_duration_seconds{instance=~\"$instance\", id=~\"$script\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Unlock status by script",
      "transformations": [
        { "id": "joinByField", "options": { "byField": "id", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true,
              "instance": true, "instance 1": true, "instance 2": true, "instance 3": true,
              "job": true, "job 1": true, "job 2": true, "job 3": true
            },
            "indexByName": {
              "Value #A": 3, "Value #B": 4, "Value #C": 5,
              "category": 2, "id": 0, "name": 1, "region": 6, "detected_region": 7, "tags": 8
            },
            "renameByName": {
              "Value #A": "Status", "Value #B": "Last success", "Value #C": "Duration",
              "category": "Category", "id": "ID", "name": "Name",
              "region": "Configured region", "detected_region": "Detected region", "tags": "Tags"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 11,
      "panels": [],
      "title": "Unlock rate by segment",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Percentage of selected scripts reporting status 1 (unlocked), grouped by script category.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "id": 12,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "100 * sum by (category) (\n  (\n    miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"}\n      * on(job, instance, id) group_left(category)\n        miaoprobe_script_info{instance=~\"$instance\", category=~\"$category\", id=~\"$script\"}\n  ) == bool 1\n)\n/\ncount by (category) (\n  miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"}\n    * on(job, instance, id) group_left(category)\n      miaoprobe_script_info{instance=~\"$instance\", category=~\"$category\", id=~\"$script\"}\n)",
          "instant": true,
          "legendFormat": "{{category}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Unlocked rate by category",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Percentage of selected scripts reporting status 1 (unlocked), grouped by the region detected by the latest successful probe.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "id": 13,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "label_replace(\n  100 * sum by (detected_region) (\n    (\n      miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"}\n        * on(job, instance, id) group_left(detected_region)\n          label_replace(\n            miaoprobe_probe_result_info{instance=~\"$instance\", id=~\"$script\"},\n            \"detected_region\", \"$1\", \"region\", \"(.*)\"\n          )\n    ) == bool 1\n  )\n  /\n  count by (detected_region) (\n    miaoprobe_unlock_status{instance=~\"$instance\", id=~\"$script\"}\n      * on(job, instance, id) group_left(detected_region)\n        label_replace(\n          miaoprobe_probe_result_info{instance=~\"$instance\", id=~\"$script\"},\n          \"detected_region\", \"$1\", \"region\", \"(.*)\"\n        )\n  ),\n  \"detected_region\", \"unknown\", \"detected_region\", \"^$\"\n)",
          "instant": true,
          "legendFormat": "{{detected_region}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Unlocked rate by detected region",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 14,
      "panels": [],
      "title": "Probe details",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Dynamic fields returned by the latest successful probe, such as IP quality. Values are labels and the sample value is always 1.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "Key" },
            "properties": [{ "id": "custom.width", "value": 140 }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "id": 15,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "ID" }, { "desc": false, "displayName": "Key" }]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "miaoprobe_probe_extra_info{instance=~\"$instance\", id=~\"$script\", region=~\"$probe_region\"}\n  * on(job, instance, id) group_left(name, category)\n    miaoprobe_script_info{instance=~\"$instance\", category=~\"$category\", id=~\"$script\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Probe result details",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true },
            "indexByName": {
              "instance": 0, "id": 1, "name": 2, "category": 3, "region": 4,
              "key": 5, "label": 6, "value": 7, "type": 8, "unit": 9
            },
            "renameByName": {
              "instance": "Instance", "id": "ID", "name": "Name", "category": "Category",
              "region": "Detected region", "key": "Key", "label": "Label", "value": "Value",
              "type": "Type", "unit": "Unit"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 16,
      "panels": [],
      "title": "Status history",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Status over time per script. Grey \"Unknown\" bands are checks that errored or returned n/a — treat them as \"no information\", not as a confirmed failure.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "fillOpacity": 85,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "-1": { "color": "#8e8c8e", "index": 3, "text": "Unknown" },
                "0": { "color": "red", "index": 2, "text": "Failed" },
                "0.5": { "color": "orange", "index": 1, "text": "Warning" },
                "1": { "color": "green", "index": 0, "text": "Unlocked" }
              },
              "type": "value"
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 42 },
      "id": 17,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
